# Copy to .env and adjust as needed. docker-compose reads this automatically.

# Airflow container UID; on Linux, set to `id -u` so mounted volumes aren't root-owned.
AIRFLOW_UID=50000

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Optional: post a message here whenever a DAG task fails.
SLACK_WEBHOOK_URL=

# --- GCP target (only needed once you swap dbt to `--target prod`) ---
GCP_PROJECT_ID=
GCP_KEYFILE_PATH=
